# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GA_MEASUREMENT_ID: Optional Google Analytics 4 measurement ID (e.g.
# "G-XXXXXXXXXX"). Analytics is loaded only when this is set; leave it unset to
# disable tracking entirely. Must be VITE_-prefixed to be exposed to the client.
VITE_GA_MEASUREMENT_ID=""

# ---------------------------------------------------------------------------
# SaaS mode (Supabase). When BOTH are set the app enables accounts, workspaces
# and cloud-saved projects. Leave them empty to run in single-user local mode
# (designs persist to the browser's localStorage, exactly as before).
#
# 1. Create a project at https://supabase.com
# 2. Apply the schema in supabase/migrations/0001_init.sql (SQL editor or CLI)
# 3. Copy the Project URL and the anon/publishable key below.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Billing (Stripe). Server-side only — these must NOT be VITE_-prefixed so the
# secret key never reaches the browser. Billing stays disabled until they are
# set; the app and SaaS features work fine without them.
#
# Setup:
# 1. Create two recurring Prices in Stripe (Pro and Team) and copy their IDs.
# 2. Add a webhook endpoint -> https://<your-host>/api/stripe/webhook
#    subscribed to: checkout.session.completed, customer.subscription.created,
#    customer.subscription.updated, customer.subscription.deleted.
# 3. Fill in the values below and restart the server.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""

# Server-side Supabase access for the Stripe webhook (writes subscription rows,
# bypassing RLS) and for verifying user JWTs on billing calls.
# SUPABASE_URL falls back to VITE_SUPABASE_URL if omitted.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
